---
import "../styles/global.css";

export interface Props {
  title?: string;
}

const { title = "Verde Health" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="min-h-screen bg-white text-gray-800 antialiased">

    <!-- TOP BAR (FULL VIEW, MEDICAL GREEN) -->
    <div
      class="w-full text-white"
      style="background-color:#0c8a3b;"
      data-full-topbar
    >
      <div class="max-w-6xl mx-auto h-14 flex items-center justify-end gap-6 px-4">

        <!-- Search icon -->
        <button
          class="hover:opacity-80 flex items-center justify-center"
          type="button"
          aria-label="Open search"
          data-search-toggle
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="white"
          >
            <circle cx="11" cy="11" r="7" stroke-width="2" />
            <line x1="16.65" y1="16.65" x2="21" y2="21" stroke-width="2" />
          </svg>
        </button>

        <!-- Globe + Verde Health pill -->
        <a
          href="/"
          class="flex items-center gap-3 px-7 py-2.5 rounded-full text-sm md:text-base font-semibold shadow"
          style="background-color:#0c8a3b;"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24">
            <circle
              cx="12"
              cy="12"
              r="9"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
            />
            <path
              d="M12 3c-2.7 2.4-4 5.5-4 9s1.3 6.6 4 9c2.7-2.4 4-5.5 4-9s-1.3-6.6-4-9z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
            />
            <line
              x1="5"
              y1="9"
              x2="19"
              y2="9"
              stroke="currentColor"
              stroke-width="1.4"
            />
            <line
              x1="5"
              y1="15"
              x2="19"
              y2="15"
              stroke="currentColor"
              stroke-width="1.4"
            />
          </svg>

          <span>Verde Health</span>
        </a>

        <!-- Donate button (full view) -->
        <a
          href="/donate"
          class="flex items-center gap-3 px-7 py-2.5 rounded-full text-sm md:text-base font-semibold shadow"
          style="background-color:#0c8a3b;"
        >
          <svg
            class="w-7 h-7"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M12 4.6c-.9-1.1-2.5-1.3-3.6-.4-1.2.9-1.4 2.6-.4 3.7l4 4 4-4c1-1.1.8-2.8-.4-3.7-1.1-.9-2.7-.7-3.6.4z"
              fill="currentColor"
            />
            <path
              d="M3 15.5h7.2c.5 0 1-.2 1.4-.6l1.7-1.6a1.5 1.5 0 0 1 2.1 0c.6.6.6 1.5 0 2.1l-1.3 1.3a3.9 3.9 0 0 1-2.7 1.1H7.4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M3 15.5v1.5c0 1 .8 1.8 1.8 1.8H9"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>Donate</span>
        </a>
      </div>
    </div>

    <!-- FULL NAVIGATION (TOP OF PAGE) -->
    <header class="border-b" data-full-nav id="top-nav">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center gap-14">

        <!-- Logo: text + medical cross -->
        <a href="/" class="flex items-center gap-2">
          <span class="text-emerald-700 text-xl font-extrabold">
            Verde Health
          </span>
          <svg
            class="w-7 h-7"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <rect x="9" y="3" width="6" height="18" rx="1.2" fill="#0c8a3b" />
            <rect x="3" y="9" width="18" height="6" rx="1.2" fill="#0c8a3b" />
          </svg>
        </a>

        <!-- NAVIGATION MENU (click + / × submenus) -->
        <nav class="hidden md:flex items-center gap-14 text-sm">

          <!-- ABOUT US -->
          <div class="relative">
            <button
              type="button"
              class="flex items-center gap-1 font-semibold hover:text-emerald-700"
              data-menu-toggle="about"
            >
              <span>About Us</span>
              <span class="text-lg leading-none" data-menu-icon="about">+</span>
            </button>

            <div
              class="absolute left-0 mt-2 w-72 rounded-xl border bg-white shadow-lg py-2 text-sm hidden z-20"
              data-menu-panel="about"
            >
              <ul>
                <li>
                  <a class="block px-4 py-2 hover:bg-emerald-50" href="/about/history">
                    Our History
                  </a>
                </li>
                <li>
                  <a class="block px-4 py-2 hover:bg-emerald-50" href="/about/vision-mission-values">
                    Vision, Mission &amp; Values
                  </a>
                </li>
                <li>
                  <a class="block px-4 py-2 hover:bg-emerald-50" href="/about/board-leadership-team">
                    Board, Leadership &amp; Team
                  </a>
                </li>
                <li>
                  <a class="block px-4 py-2 hover:bg-emerald-50" href="/about/founder">
                    Our Founder
                  </a>
                </li>
                <li>
                  <a class="block px-4 py-2 hover:bg-emerald-50" href="/about/awards-recognitions">
                    Awards &amp; Recognitions
                  </a>
                </li>
                <li>
                  <a class="block px-4 py-2 hover:bg-emerald-50" href="/about/annual-reports">
                    Annual Reports
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <!-- SOLUTIONS ECOSYSTEM -->
          <div class="relative">
            <button
              type="button"
              class="flex items-center gap-1 font-semibold hover:text-emerald-700"
              data-menu-toggle="solutions"
            >
              <span>Solutions Ecosystem</span>
              <span class="text-lg leading-none" data-menu-icon="solutions">+</span>
            </button>

            <div
              class="absolute left-0 mt-2 w-[26rem] rounded-xl border bg-white shadow-lg py-2 text-sm hidden z-20"
              data-menu-panel="solutions"
            >
              <ul>
                <li><a class="block px-4 py-2 hover:bg-emerald-50" href="/solutions/health-outreach">Health Outreach</a></li>
                <li><a class="block px-4 py-2 hover:bg-emerald-50" href="/solutions/medical-imaging-services">Medical Imaging Services</a></li>
                <li><a class="block px-4 py-2 hover:bg-emerald-50" href="/solutions/laboratory-testing">Laboratory Testing Services</a></li>
                <li><a class="block px-4 py-2 hover:bg-emerald-50" href="/solutions/environmental-assessments">Environmental Assessments</a></li>
                <li>
                  <a class="block px-4 py-2 hover:bg-emerald-50" href="/solutions/research-data-policy">
                    Research Design, Data Analysis &amp; Policy Briefs
                  </a>
                </li>
                <li>
                  <a class="block px-4 py-2 hover:bg-emerald-50" href="/solutions/baseline-midline-endline">
                    Baseline, Midline &amp; End line Studies
                  </a>
                </li>
                <li>
                  <a class="block px-4 py-2 hover:bg-emerald-50" href="/solutions/technical-consulting-capacity-building">
                    Technical Consulting &amp; Capacity Building Workshops
                  </a>
                </li>
                <li><a class="block px-4 py-2 hover:bg-emerald-50" href="/solutions/social-work-programs">Social Work Programs</a></li>
                <li>
                  <a class="block px-4 py-2 hover:bg-emerald-50" href="/solutions/behaviour-change-health-comms">
                    Behavioral Change &amp; Health Communication Campaigns
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <!-- COMMUNITY IMPACT -->
          <div class="relative">
            <button
              type="button"
              class="flex items-center gap-1 font-semibold hover:text-emerald-700"
              data-menu-toggle="impact"
            >
              <span>Community Impact</span>
              <span class="text-lg leading-none" data-menu-icon="impact">+</span>
            </button>

            <div
              class="absolute left-0 mt-2 w-48 rounded-xl border bg-white shadow-lg py-2 text-sm hidden z-20"
              data-menu-panel="impact"
            >
              <ul>
                <li><a class="block px-4 py-2 hover:bg-emerald-50" href="/impact/kitwe">Kitwe</a></li>
                <li><a class="block px-4 py-2 hover:bg-emerald-50" href="/impact/kalulushi">Kalulushi</a></li>
                <li><a class="block px-4 py-2 hover:bg-emerald-50" href="/impact/chambishi">Chambishi</a></li>
              </ul>
            </div>
          </div>

          <!-- LATEST FROM US -->
          <div class="relative">
            <button
              type="button"
              class="flex items-center gap-1 font-semibold hover:text-emerald-700"
              data-menu-toggle="latest"
            >
              <span>Latest From Us</span>
              <span class="text-lg leading-none" data-menu-icon="latest">+</span>
            </button>

            <div
              class="absolute left-0 mt-2 w-56 rounded-xl border bg-white shadow-lg py-2 text-sm hidden z-20"
              data-menu-panel="latest"
            >
              <ul>
                <li><a class="block px-4 py-2 hover:bg-emerald-50" href="/latest/publications">Publications</a></li>
              </ul>
            </div>
          </div>

          <!-- CAREERS (no submenu) -->
          <a href="/careers" class="font-semibold hover:text-emerald-700">
            Careers
          </a>

          <!-- PARTNER WITH US (no submenu) -->
          <a href="/partner" class="font-semibold hover:text-emerald-700">
            Partner With Us
          </a>

        </nav>
      </div>
    </header>

    <!-- COMPACT STICKY HEADER (ON SCROLL) -->
    <header
      class="fixed top-0 left-0 w-full bg-white border-b shadow z-40 h-12 px-4 flex items-center justify-between hidden"
      data-compact-header
    >
      <!-- Small logo -->
      <a href="/" class="flex items-center gap-2">
        <span class="text-emerald-700 font-extrabold text-base">
          Verde Health
        </span>
        <svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="9" y="3" width="6" height="18" rx="1.2" fill="#0c8a3b" />
          <rect x="3" y="9" width="18" height="6" rx="1.2" fill="#0c8a3b" />
        </svg>
      </a>

      <div class="flex items-center gap-4">
        <!-- Menu button (scrolls back to top) -->
        <button
          type="button"
          class="flex items-center gap-2 text-sm font-semibold"
          data-compact-menu-btn
        >
          <span class="text-xl leading-none">☰</span>
          <span>Menu</span>
        </button>

        <!-- Donate (compact view) -->
        <a
          href="/donate"
          class="flex items-center gap-2 px-5 py-1.5 rounded-full text-sm font-semibold text-white"
          style="background-color:#0c8a3b;"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 4.6c-.9-1.1-2.5-1.3-3.6-.4-1.2.9-1.4 2.6-.4 3.7l4 4 4-4c1-1.1.8-2.8-.4-3.7-1.1-.9-2.7-.7-3.6.4z"
              fill="currentColor"
            />
            <path
              d="M3 15.5h7.2c.5 0 1-.2 1.4-.6l1.7-1.6a1.5 1.5 0 0 1 2.1 0c.6.6.6 1.5 0 2.1l-1.3 1.3a3.9 3.9 0 0 1-2.7 1.1H7.4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M3 15.5v1.5c0 1 .8 1.8 1.8 1.8H9"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>Donate</span>
        </a>
      </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="max-w-6xl mx-auto px-4 py-10">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="border-t">
      <div class="max-w-6xl mx-auto px-4 py-6 text-sm text-gray-500">
        © {new Date().getFullYear()} Verde Health. All rights reserved.
      </div>
    </footer>

    <!-- SEARCH OVERLAY -->
    <div
      class="fixed inset-0 bg-black/40 z-50 hidden items-start justify-center pt-24 px-4"
      data-search-overlay
    >
      <div
        class="w-full max-w-xl bg-white rounded-2xl shadow-lg p-4 flex flex-col gap-3"
        role="dialog"
        aria-modal="true"
        aria-label="Search Verde Health"
      >
        <div class="flex items-center gap-3">
          <input
            type="search"
            placeholder="Search Verde Health..."
            class="flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
            data-search-input
          />
          <button
            type="button"
            class="text-sm font-semibold text-emerald-700"
            data-search-close
          >
            Cancel
          </button>
        </div>
        <!-- Placeholder text; later you can hook this up to real search results -->
        <p class="text-xs text-gray-500">
         
        </p>
      </div>
    </div>

    <!-- MENU + SCROLL + SEARCH BEHAVIOUR -->
    <!-- MENU + SCROLL + SEARCH BEHAVIOUR -->
        <!-- MENU + SCROLL + SEARCH (compact header only, no jitter) -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // + / × toggle desktop dropdown menus
        const toggles = document.querySelectorAll("[data-menu-toggle]");
        toggles.forEach((btn) => {
          const id = btn.getAttribute("data-menu-toggle");
          const panel = document.querySelector(
            '[data-menu-panel="' + id + '"]'
          );
          const icon = document.querySelector(
            '[data-menu-icon="' + id + '"]'
          );
          if (!panel || !icon) return;

          btn.addEventListener("click", () => {
            const isHidden = panel.classList.contains("hidden");

            // close all menus first
            document
              .querySelectorAll("[data-menu-panel]")
              .forEach((p) => p.classList.add("hidden"));
            document
              .querySelectorAll("[data-menu-icon]")
              .forEach((i) => (i.textContent = "+"));

            // then toggle clicked one
            if (isHidden) {
              panel.classList.remove("hidden");
              icon.textContent = "×";
            } else {
              panel.classList.add("hidden");
              icon.textContent = "+";
            }
          });
        });

        // SHOW / HIDE COMPACT HEADER ON SCROLL (does NOT touch full header)
        const compactHeader = document.querySelector("[data-compact-header]");

        const handleScroll = () => {
          if (!compactHeader) return;
          const showCompact = window.scrollY > 140; // adjust threshold if you like

          if (showCompact) {
            compactHeader.classList.remove("hidden");
          } else {
            compactHeader.classList.add("hidden");
          }
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
        handleScroll();

        // compact "Menu" button: scroll back to top
        const compactMenuBtn = document.querySelector(
          "[data-compact-menu-btn]"
        );
        if (compactMenuBtn) {
          compactMenuBtn.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
          });
        }

        // SEARCH OVERLAY
        const searchOverlay = document.querySelector("[data-search-overlay]");
        const searchInput = document.querySelector("[data-search-input]");
        const searchToggleBtns =
          document.querySelectorAll("[data-search-toggle]");
        const searchCloseBtns =
          document.querySelectorAll("[data-search-close]");

        const openSearch = () => {
          if (!searchOverlay) return;
          searchOverlay.classList.remove("hidden");
          searchOverlay.classList.add("flex");
          document.body.classList.add("overflow-hidden");
          if (searchInput) {
            setTimeout(() => searchInput.focus(), 50);
          }
        };

        const closeSearch = () => {
          if (!searchOverlay) return;
          searchOverlay.classList.add("hidden");
          searchOverlay.classList.remove("flex");
          document.body.classList.remove("overflow-hidden");
        };

        searchToggleBtns.forEach((btn) =>
          btn.addEventListener("click", openSearch)
        );
        searchCloseBtns.forEach((btn) =>
          btn.addEventListener("click", closeSearch)
        );

        if (searchOverlay) {
          // click on dark backdrop closes search
          searchOverlay.addEventListener("click", (e) => {
            if (e.target === searchOverlay) {
              closeSearch();
            }
          });
        }

        // ESC key closes search
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            closeSearch();
          }
        });
      });
    </script>

  </body>
</html>
