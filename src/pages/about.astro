---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About — Verde Health">
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-extrabold text-emerald-700">About Verde Health</h1>
    <p class="mt-6 text-lg text-gray-700 leading-relaxed">
      Verde Health is a community-driven initiative focused on expanding essential healthcare
      in underserved areas. We champion practical solutions: prevention, screening, referral
      pathways, and responsible pharmaceutical services, delivered with transparency and local partnership.
    </p>

    <h2 class="mt-10 text-2xl font-bold text-emerald-700">Our Approach</h2>
    <ul class="mt-4 space-y-3 text-gray-700">
      <li>Patient-first design and affordability</li>
      <li>Partnerships with clinics, universities, and local leaders</li>
      <li>Data-informed programs and measurable outcomes</li>
    </ul>
  </section>
</Layout>
